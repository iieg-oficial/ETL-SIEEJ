# ====================================================================
# POBREZA_MULTIDIMENCIONAL — Variables de entorno
# Copiar a .env y completar con las credenciales reales.
# ====================================================================

# Base de datos
DB_HOST=localhost
DB_PORT=5434
DB_USER=<usuario>
DB_PASSWORD=<contraseña>
DB_NAME=pobreza_multidimencional

# Logging
LOG_LEVEL=INFO

# Fuente (ZIP con XLSX de CONEVAL — indicadores municipales 2010/2015/2020)
POBREZA_MULTIDIMENCIONAL_SOURCE_URL=https://www.coneval.org.mx/Medicion/Documents/Pobreza_municipal/2020/Concentrado_indicadores_de_pobreza_2020.zip

# Tamaño de lote para inserción masiva
POBREZA_MULTIDIMENCIONAL_LOAD_BATCH_SIZE=2000
