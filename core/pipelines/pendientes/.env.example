LOG_LEVEL="INFO"
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=pendientes

SOURCE_URL=https://www.inegi.org.mx/contenidos/productos/prod_serv/contenidos/espanol/bvinegi/productos/geografia/relieve/794551151600_t.zip
# Para reutilizar un TIFF ya descargado, establece esta ruta y SOURCE_URL puede quedar vacío.
SOURCE_TIFF_PATH=
# Snapshot EWKB materializado mediante una consulta real a cvegeo cuando no hay conexión TCP directa.
CVEGEO_BOUNDARY_SNAPSHOT_PATH=
SOURCE_ZIP_FILENAME=794551151600_t.zip
FORCE_DOWNLOAD=false
DOWNLOAD_RETRIES=5
DOWNLOAD_CONNECT_TIMEOUT=30
DOWNLOAD_READ_TIMEOUT=600
DOWNLOAD_CHUNK_SIZE=1048576

TARGET_SRID=6368
TARGET_RESOLUTION_M=15
AOI_BUFFER_M=10000
BOUNDARY_GEOMETRY_COLUMN=geom_iieg
STATS_MAX_CELLS=5000000
DIAGNOSTIC_SAMPLE_MAX_CELLS=2000000

# Fase 4 experimental: el chip manual es opcional y ambas coordenadas son EPSG:6368.
EXPERIMENT_MANUAL_X=
EXPERIMENT_MANUAL_Y=
# Whitebox debe apuntar a un binario ya descargado. Versión y SHA-256 son obligatorios para ejecutarlo.
WHITEBOX_TOOLS_EXECUTABLE=
WHITEBOX_TOOLS_EXPECTED_VERSION=
WHITEBOX_TOOLS_EXPECTED_SHA256=
