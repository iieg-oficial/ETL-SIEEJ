LOG_LEVEL="INFO"
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=pendientes

SOURCE_URL=https://www.inegi.org.mx/contenidos/productos/prod_serv/contenidos/espanol/bvinegi/productos/geografia/relieve/794551151600_t.zip
SOURCE_ZIP_FILENAME=794551151600_t.zip
FORCE_DOWNLOAD=false
DOWNLOAD_RETRIES=5
DOWNLOAD_CONNECT_TIMEOUT=30
DOWNLOAD_READ_TIMEOUT=600
DOWNLOAD_CHUNK_SIZE=1048576

TARGET_SRID=6368
TARGET_RESOLUTION_M=15
AOI_BUFFER_M=10000
BOUNDARY_GEOMETRY_COLUMN=geom_iieg
STATS_MAX_CELLS=5000000
DIAGNOSTIC_SAMPLE_MAX_CELLS=2000000

# Variables opcionales. Si quedan comentadas, Extract usa el comportamiento por defecto.

# Reutiliza un TIFF ya descargado en lugar de bajarlo desde SOURCE_URL.
# SOURCE_TIFF_PATH=data/extract/pendientes/raw/continuonacional_15m.tif

# Reutiliza un GeoPackage con las capas municipios_iieg, municipios_inegi, estado_iieg y estado_inegi.
# Por defecto Extract consulta la base compartida cvegeo y materializa el archivo indicado.
# CVEGEO_MUNICIPAL_BOUNDARY_SNAPSHOT_PATH=data/extract/pendientes/municipal_boundaries.gpkg
