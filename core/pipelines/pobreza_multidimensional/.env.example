# ====================================================================
# POBREZA_MULTIDIMENSIONAL — Variables de entorno
# Copiar a .env y completar con las credenciales reales.
# ====================================================================

# Base de datos
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=<DB_NAME>

# Logging
LOG_LEVEL=INFO

# Fuente (ZIP con XLSX de CONEVAL — indicadores municipales 2010/2015/2020)
POBREZA_MULTIDIMENSIONAL_SOURCE_URL=https://www.coneval.org.mx/Medicion/Documents/Pobreza_municipal/2020/Concentrado_indicadores_de_pobreza_2020.zip

# Tamaño de lote para inserción masiva
POBREZA_MULTIDIMENSIONAL_LOAD_BATCH_SIZE=2000
XLSX_FILENAME=Concentrado_indicadores_de_pobreza_2020.xlsx
