# ====================================================================
# POBREZA_MULTIDIMENSIONAL — Variables de entorno
# Copiar a .env y completar con las credenciales reales.
# ====================================================================

# Base de datos
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=<DB_NAME>

# Fuente
SOURCE_URL_TEMPLATE=https://www.coneval.org.mx/Medicion/MP/Documents/MMP_2022/Programas_calculo/Python_MMP_{year}.zip

# Carga
POBREZA_MULTIDIMENSIONAL_LOAD_BATCH_SIZE=5000
