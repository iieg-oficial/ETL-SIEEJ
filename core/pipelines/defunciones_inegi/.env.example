DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defunciones_inegi
LOG_LEVEL=INFO

# Raíz de los datos abiertos del programa EDR.
SOURCE_BASE_URL=https://www.inegi.org.mx/contenidos/programas/edr/datosabiertos/defunciones

# Plantillas del archivo por año, separadas por coma y probadas en ese orden.
# INEGI renombró el ZIP tres veces sin cambiar la ruta: edr (2024),
# defunciones_registradas (2018-2023) y defunciones_generales (2017).
SOURCE_URL_TEMPLATES={year}/conjunto_de_datos_edr{year}_csv.zip,{year}/conjunto_de_datos_defunciones_registradas_{year}_csv.zip,{year}/conjunto_de_datos_defunciones_generales_{year}_csv.zip

# Primera edición a cargar en bootstrap. INEGI publica EDR desde 2017.
BACKFILL_MIN_YEAR=2017

# Segundos de espera por descarga; los ZIP pesan cientos de MB.
DOWNLOAD_TIMEOUT=600

# Filas por lote al leer el CSV de hechos y al hacer bulk insert.
CHUNK_SIZE=50000
