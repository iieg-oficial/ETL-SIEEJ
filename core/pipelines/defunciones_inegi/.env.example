LOG_LEVEL="INFO"
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=defunciones_inegi

SOURCE_CATALOG_URL=https://www.inegi.org.mx/app/api/descarga/componente/descargamasiva/lista/archivoscompaginacion?tema=0&subtema=0&areaGeografica=0&proyecto=0&anio=0&tipodocto=12&agrupacion=VG9kYXM%3D&idBiinegi=3358&desde=1&hasta=1000&textoBuscar=&ordenar=orden&ingles=0&datosAbiertos=1&orden=desc
SOURCE_CONTENT_URL=https://www.inegi.org.mx/contenidos
CATALOG_TIMEOUT=60
SOURCE_BASE_URL=https://www.inegi.org.mx/contenidos/programas/edr/datosabiertos/defunciones
SOURCE_URL_TEMPLATES={year}/conjunto_de_datos_edr{year}_csv.zip,{year}/conjunto_de_datos_defunciones_registradas_{year}_csv.zip,{year}/conjunto_de_datos_defunciones_generales_{year}_csv.zip
BACKFILL_MIN_YEAR=2017
DOWNLOAD_TIMEOUT=600
CHUNK_SIZE=50000
