LOG_LEVEL="INFO"
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=defunciones_inegi

SOURCE_BASE_URL=https://www.inegi.org.mx/contenidos/programas/edr/datosabiertos/defunciones
SOURCE_URL_TEMPLATES={year}/conjunto_de_datos_edr{year}_csv.zip,{year}/conjunto_de_datos_defunciones_registradas_{year}_csv.zip,{year}/conjunto_de_datos_defunciones_generales_{year}_csv.zip
BACKFILL_MIN_YEAR=2017
DOWNLOAD_TIMEOUT=600
CHUNK_SIZE=50000
