LOG_LEVEL="INFO"
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=defunciones

CHUNK_SIZE=10000
CATALOG_URL=<CATALOG_URL> #(opcional): fija una edición de catálogos; si se omite, se autodescubre
REGISTRO_URL=<REGISTRO_URL> #(opcional): fija una edición de registro; si se omite, se autodescubre
BACKFILL_MIN_YEAR=2019 #(opcional): año mínimo del backfill en bootstrap
CATALOGO_2021_FILE_ID=<CATALOGO_2021_FILE_ID> #(requerido): id del espejo en Drive del catálogo 2021; ver README
