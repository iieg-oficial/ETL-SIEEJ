flyway.url=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>
flyway.user=<DB_USER>
flyway.password=<DB_PASSWORD>
flyway.locations=filesystem:./sql/
flyway.schemas=public
flyway.cleanDisabled=false

# Foreign Data Wrapper - conexión a la DB de cvegeo
flyway.placeholders.fdw_dbname=cvegeo
flyway.placeholders.fdw_host=localhost
flyway.placeholders.fdw_port=5433
flyway.placeholders.fdw_user=cvegeo
flyway.placeholders.fdw_password=cvegeo
