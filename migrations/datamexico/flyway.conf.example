flyway.url=jdbc:postgresql://<DB_HOST>:<DB_PORT>/datamexico
flyway.user=<DB_USER>
flyway.password=<DB_PASSWORD>
flyway.locations=migrations/datamexico/sql
flyway.schemas=public
flyway.cleanDisabled=false

